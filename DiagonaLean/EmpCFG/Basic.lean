import Mathlib.Computability.ContextFreeGrammar

@[expose] public section

/-! # Empty intersection of CFGs

The decision problem asks whether the languages of two context-free grammars share a word.
`IntersectionEmpty G1 G2` states that no word is generated by both grammars and
`IntersectionNonempty G1 G2` that some word is; they are complementary
(`not_intersectionEmpty_iff_nonempty`). `DecisionProblem` is non-emptiness of the intersection of
a pair of grammars.

This is one of the standard problems shown undecidable by reduction from PCP
(see [HopcroftMotwaniUllman2006] Theorem 9.22).

To audit the definition, read `IntersectionNonempty` and `decisionProblem_mk`, which is pinned in
`scripts/HeadlineTest.lean`.

## References

* [J. E. Hopcroft, R. Motwani, J. D. Ullman,
  *Introduction to Automata Theory, Languages, and Computation*][HopcroftMotwaniUllman2006]
-/

namespace DiagonaLean.EmpCFG

open ContextFreeGrammar

variable {T : Type}

/-- `L(G1) ∩ L(G2) = ∅`: no word is generated by both grammars. -/
def IntersectionEmpty (G1 G2 : ContextFreeGrammar T) : Prop :=
  ∀ w : List T, ¬ (w ∈ G1.language ∧ w ∈ G2.language)

/-- `L(G1) ∩ L(G2) ≠ ∅`: some word is generated by both grammars. -/
def IntersectionNonempty (G1 G2 : ContextFreeGrammar T) : Prop :=
  ∃ w : List T, w ∈ G1.language ∧ w ∈ G2.language

/-- `IntersectionEmpty G1 G2` fails iff `IntersectionNonempty G1 G2` holds. -/
theorem not_intersectionEmpty_iff_nonempty (G1 G2 : ContextFreeGrammar T) :
    ¬ IntersectionEmpty G1 G2 ↔ IntersectionNonempty G1 G2 := by
  unfold IntersectionEmpty IntersectionNonempty
  grind

/-! ### The problem on instances, for the reductions and the computability statements -/

/-- **The problem on a pair `(G₁, G₂)` of grammars**, for the reductions and the computability
statements: `IntersectionNonempty G₁ G₂`. Read it curried, `decisionProblem_mk`. -/
def DecisionProblem (G : ContextFreeGrammar T × ContextFreeGrammar T) : Prop :=
  IntersectionNonempty G.1 G.2

/-- The problem on a pair `(G₁, G₂)` is the curried problem. -/
@[simp] theorem decisionProblem_mk (G₁ G₂ : ContextFreeGrammar T) :
    DecisionProblem (G₁, G₂) ↔ IntersectionNonempty G₁ G₂ := Iff.rfl

end DiagonaLean.EmpCFG
