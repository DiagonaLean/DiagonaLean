@[expose] public section

/-! # Problems as functors on codes, and lifting them to every alphabet

Alphabets with letterwise codes `c : α → List β` as morphisms form a category (the Kleisli
category of `List`, restricted to a class `Good` of codes such as `IsCode` or `IsSync`). A problem
over every alphabet is a `CodeFunctor Good`: a type of instances `Inst α` for each alphabet, the
action `map c` of a code on instances (encode every word of the instance), a predicate `Prob`
that every good code preserves and reflects (`natural`), and the letters an instance uses
(`supp`), on which alone the action depends (`map_congr`). `Prob` is a natural transformation from
`Inst` to the constant functor `Prop`: the square

```
          map c
  Inst α ──────► Inst β
     Prob ╲      ╱ Prob
           Prop
```
commutes.

**The lift.** An instance uses finitely many letters, so it is encoded by a code built from them
(`localCode`: the unary code of a letter's position among them, over two distinct letters of the
target). That code is good only on the letters of the instance, which suffices: naturality for such
codes follows from naturality for good codes and the functor laws (`CodeFunctor.natural_on`), by
moving the instance to the subtype of its letters. So the lifting is proved once for every
problem, from any alphabet with decidable equality to any alphabet with two distinct letters:

* `CodeFunctor.lift`: the many-one reduction (data), and `CodeFunctor.undecidableOf`.
* `CodeFunctor.not_computablePred_lift`: `¬ ComputablePred` transfers, once the lift's function
  `liftMap` is computable. Instances are built from words by products and lists, so `fun_prop`
  proves it from `encode_prim` (generated by `derive_primrec`, for a code that depends on the
  instance) and `localCode_prim`.
* `CodeFunctor.manyOneEquiv`: over two `Primcodable` alphabets with two letters each, the problem
  is many-one equivalent in Mathlib's sense: its many-one degree does not depend on the alphabet.
  The reductions are data (`F.lift`); with a computable function they give Mathlib's
  `ManyOneReducible` (`ManyOneReduces.toManyOneReducible`). Every property closed under computable
  many-one reductions transports, for instance being a computable predicate
  (`computablePred_iff_of_equiv`) or recursively enumerable (`rePred_iff_of_equiv`); for a single
  reduction as data, `computablePred_of_reduces` and `REPred.of_reduces` take `p ⪯ₘ q` directly.

The tactic `code_lift` (`Codes/Tactic.lean`) applies the matching theorem and closes its side
goals, leaving what it cannot prove as named goals.

The unary code is synchronizing (`isSync_unary`), so one lift serves problems that need only
injectivity (`IsCode`: correspondence problems, grammars) and those that need synchronization
(`IsSync`: rewriting). A class of good codes provides the three facts the lift uses
(`LiftableCodes`).
-/

namespace DiagonaLean.Foundations.Codes

open DiagonaLean.Synthetic.Notation DiagonaLean.Foundations.Computability

/-! ### Computability of the encodings -/

/- `encode_prim`: encoding is primitive recursive, for a code that may depend on the input. -/
derive_primrec encode [Primcodable α] [Primcodable β]

theorem unary_primrec : Primrec unary := by
  unfold unary
  fun_prop

/-- The code of a letter from its position among the letters `S`: the unary code of the position,
in the letters `b0`, `b1`. -/
def localCode {α β : Type} [DecidableEq α] (b0 b1 : β) (S : List α) (a : α) : List β :=
  bitCode (α := ℕ) b0 b1 (S.idxOf a)

@[fun_prop] theorem localCode_prim {α β X : Type} [Primcodable α] [Primcodable β] [Primcodable X]
    [DecidableEq α] {b0 b1 : X → β} {S : X → List α} {a : X → α} (h0 : Primrec b0)
    (h1 : Primrec b1) (hS : Primrec S) (ha : Primrec a) :
    Primrec fun x => localCode (b0 x) (b1 x) (S x) (a x) := by
  unfold localCode bitCode ofEncodable bit
  have := unary_primrec
  fun_prop

/-! ### Classes of good codes -/

/-- The facts about a class of good codes that the lift uses: it is closed under precomposing
with injective renamings, and contains the identity code and the unary code of the natural
numbers. -/
class LiftableCodes (Good : ∀ {α β : Type}, (α → List β) → Prop) : Prop where
  /-- Precomposing with an injective renaming of letters keeps a code good. -/
  comp_inj : ∀ {α β γ : Type} {c : β → List γ} {f : α → β}, Good c → Function.Injective f →
    Good (c ∘ f)
  /-- The identity code is good. -/
  unit_good : ∀ {α : Type}, Good (unit (α := α))
  /-- The unary code of the natural numbers, in two distinct letters, is good. -/
  bitCode_good : ∀ {β : Type} {b0 b1 : β}, b0 ≠ b1 → Good (bitCode (α := ℕ) b0 b1)

instance liftableCodes_isCode : LiftableCodes IsCode :=
  ⟨fun hc hf => hc.comp hf, @fun _ => isCode_unit, fun hne => (isSync_bitCode hne).isCode⟩

instance liftableCodes_isSync : LiftableCodes IsSync :=
  ⟨fun hc hf => hc.comp hf, isSync_unit, fun hne => isSync_bitCode hne⟩

/-- `localCode` is good on the letters `S`: positions of distinct members of `S` differ. -/
theorem good_localCode {Good : ∀ {α β : Type}, (α → List β) → Prop} [LiftableCodes Good]
    {α β : Type} [DecidableEq α] {b0 b1 : β} (hne : b0 ≠ b1) (S : List α) :
    Good fun a : {a // a ∈ S} => localCode b0 b1 S a.1 :=
  LiftableCodes.comp_inj (f := fun a : {a // a ∈ S} => S.idxOf a.1) (LiftableCodes.bitCode_good hne)
    fun a _ h => Subtype.ext ((List.idxOf_inj a.2).1 h)

/-! ### Problems as functors -/

/-- A problem over every alphabet, natural with respect to the codes in `Good`. -/
structure CodeFunctor (Good : ∀ {α β : Type}, (α → List β) → Prop) where
  /-- The instances over an alphabet. -/
  Inst : Type → Type
  /-- A code acts on instances by encoding their words. -/
  map : ∀ {α β : Type}, (α → List β) → Inst α → Inst β
  /-- The problem. -/
  Prob : ∀ {α : Type}, Inst α → Prop
  /-- Functor law: the identity code acts as the identity. -/
  map_unit : ∀ {α : Type} (x : Inst α), map unit x = x
  /-- Functor law: the composite of two codes acts as the composite of their actions. -/
  map_kcomp : ∀ {α β γ : Type} (c₁ : α → List β) (c₂ : β → List γ) (x : Inst α),
    map c₂ (map c₁ x) = map (kcomp c₂ c₁) x
  /-- Good codes preserve and reflect the problem. -/
  natural : ∀ {α β : Type} {c : α → List β}, Good c → ∀ x, Prob (map c x) ↔ Prob x
  /-- The letters of an instance. -/
  supp : ∀ {α : Type}, Inst α → List α
  /-- Codes that agree on the letters of an instance act alike on it. -/
  map_congr : ∀ {α β : Type} {c c' : α → List β} (x : Inst α),
    (∀ a ∈ supp x, c a = c' a) → map c x = map c' x

variable {Good : ∀ {α β : Type}, (α → List β) → Prop} (F : CodeFunctor Good) {α β : Type}

/-- **Naturality on the letters used.** A code whose restriction to the letters of an instance is
good preserves and reflects the problem on that instance. The instance is moved to the subtype of
its letters by a code (`a ↦ [⟨a, h⟩]` on its letters), where `natural` applies. -/
theorem CodeFunctor.natural_on [LiftableCodes Good] [DecidableEq α] {c : α → List β} (x : F.Inst α)
    (hc : Good fun a : {a // a ∈ F.supp x} => c a.1) : F.Prob (F.map c x) ↔ F.Prob x := by
  let ρ : α → List {a // a ∈ F.supp x} := fun a => if h : a ∈ F.supp x then [⟨a, h⟩] else []
  have hval : Good fun a : {a // a ∈ F.supp x} => unit a.1 :=
    LiftableCodes.comp_inj LiftableCodes.unit_good Subtype.val_injective
  have e₁ : F.map (fun a : {a // a ∈ F.supp x} => unit a.1) (F.map ρ x) = x :=
    calc _ = F.map (kcomp _ ρ) x := F.map_kcomp _ _ _
      _ = F.map unit x := F.map_congr x fun a ha => by simp [kcomp, ρ, ha, unit]
      _ = x := F.map_unit x
  have e₂ : F.map (fun a : {a // a ∈ F.supp x} => c a.1) (F.map ρ x) = F.map c x :=
    (F.map_kcomp _ _ _).trans (F.map_congr x fun a ha => by simp [kcomp, ρ, ha])
  rw [← e₂, F.natural hc, ← F.natural hval (F.map ρ x), e₁]

/-! ### The lift -/

/-- The function of the lift: each instance encoded by the code of its own letters. -/
def CodeFunctor.liftMap [DecidableEq α] (b0 b1 : β) (x : F.Inst α) : F.Inst β :=
  F.map (localCode b0 b1 (F.supp x)) x

/-- **The lift.** The problem over an alphabet with decidable equality many-one reduces to it
over any alphabet with two distinct letters. -/
def CodeFunctor.lift [LiftableCodes Good] [DecidableEq α] (b0 b1 : β) (hne : b0 ≠ b1) :
    @F.Prob α ⪯ₘ @F.Prob β :=
  ⟨F.liftMap b0 b1, fun x => (F.natural_on x (good_localCode hne _)).symm⟩

/-- **The lifting.** Undecidability over an alphabet with decidable equality transfers to every
alphabet with two distinct letters. -/
def CodeFunctor.undecidableOf [LiftableCodes Good] [DecidableEq α] (u : Undecidable (@F.Prob α))
    (b0 b1 : β) (hne : b0 ≠ b1) : Undecidable (@F.Prob β) :=
  undecidabilityFromReducibility u (F.lift b0 b1 hne)

/-- **The lifting at machine level, to every nontrivial alphabet**, once the lift's function is
computable. -/
theorem CodeFunctor.not_computablePred_lift [LiftableCodes Good] [Nontrivial β]
    [Primcodable (F.Inst α)] [Primcodable (F.Inst β)]
    (hmap : ∀ [DecidableEq α] (b0 b1 : β), Computable (F.liftMap (α := α) b0 b1))
    (h : ¬ ComputablePred (@F.Prob α)) : ¬ ComputablePred (@F.Prob β) := by
  classical
  obtain ⟨b0, b1, hne⟩ := exists_pair_ne β
  exact not_computablePred_of_reduces (F.lift b0 b1 hne) (hmap b0 b1) h

/-! ### Alphabet invariance -/

/-- The lift with a computable function is a computable many-one reduction. -/
theorem CodeFunctor.manyOneReducible [LiftableCodes Good] [DecidableEq α] [Primcodable (F.Inst α)]
    [Primcodable (F.Inst β)] {b0 b1 : β} (hne : b0 ≠ b1)
    (hmap : Computable (F.liftMap (α := α) b0 b1)) :
    ManyOneReducible (@F.Prob α) (@F.Prob β) :=
  (F.lift b0 b1 hne).toManyOneReducible hmap

/-- **Alphabet invariance.** Over two alphabets with two distinct letters each, the problem is
many-one equivalent, by the lift both ways. -/
theorem CodeFunctor.manyOneEquiv [LiftableCodes Good] [Nontrivial α] [Nontrivial β]
    [Primcodable (F.Inst α)] [Primcodable (F.Inst β)]
    (hmapα : ∀ [DecidableEq α] (b0 b1 : β), Computable (F.liftMap (α := α) b0 b1))
    (hmapβ : ∀ [DecidableEq β] (a0 a1 : α), Computable (F.liftMap (α := β) a0 a1)) :
    ManyOneEquiv (@F.Prob α) (@F.Prob β) := by
  classical
  obtain ⟨a0, a1, ha⟩ := exists_pair_ne α
  obtain ⟨b0, b1, hb⟩ := exists_pair_ne β
  exact ⟨F.manyOneReducible hb (hmapα b0 b1), F.manyOneReducible ha (hmapβ a0 a1)⟩

/-! ### Transport along computable reductions -/

section Transport

variable {X Y : Type} [Primcodable X] [Primcodable Y] {p : X → Prop} {q : Y → Prop}

/-- Being a computable predicate transfers back along a reduction (`⪯ₘ`) with a computable
function. -/
theorem computablePred_of_reduces (r : p ⪯ₘ q) (hr : Computable r.f) (hq : ComputablePred q) :
    ComputablePred p :=
  ComputablePred.computable_of_manyOneReducible (r.toManyOneReducible hr) hq

/-- Recursive enumerability transfers back along a reduction (`⪯ₘ`) with a computable function. -/
theorem REPred.of_reduces (r : p ⪯ₘ q) (hr : Computable r.f) (hq : REPred q) : REPred p :=
  REPred.of_eq (hq.comp hr) fun x => (r.hf x).symm

/-- Recursive enumerability transfers back along a computable many-one reduction. -/
theorem REPred.of_manyOneReducible (h : ManyOneReducible p q) (hq : REPred q) : REPred p := by
  obtain ⟨f, hf, hpq⟩ := h
  exact REPred.of_reduces (q := q) ⟨f, hpq⟩ hf hq

/-- Many-one equivalent predicates are computable together. -/
theorem computablePred_iff_of_equiv (h : ManyOneEquiv p q) : ComputablePred p ↔ ComputablePred q :=
  ⟨fun hp => ComputablePred.computable_of_manyOneReducible h.2 hp,
    fun hq => ComputablePred.computable_of_manyOneReducible h.1 hq⟩

/-- Many-one equivalent predicates are recursively enumerable together. -/
theorem rePred_iff_of_equiv (h : ManyOneEquiv p q) : REPred p ↔ REPred q :=
  ⟨fun hp => REPred.of_manyOneReducible h.2 hp, fun hq => REPred.of_manyOneReducible h.1 hq⟩

end Transport

end DiagonaLean.Foundations.Codes
