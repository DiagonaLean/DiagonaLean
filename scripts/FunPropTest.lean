example : Primrec DiagonaLean.KACommUndecidable.KleeneAlgebra.subC :=
  DiagonaLean.KACommUndecidable.KleeneAlgebra.subC_prim
example : Primrec fun n => (DiagonaLean.KACommUndecidable.KleeneAlgebra.subC n, n + 1) := by
